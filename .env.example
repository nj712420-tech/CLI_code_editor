# Example environment overrides for aide.
# Copy to `.env` (or export in your shell) — environment vars take
# precedence over config.toml. Prefix `AIDE_`, sections become `__`:
#   AIDE_<SECTION>__<KEY>
#
# The default `aide init` config targets a local Ollama endpoint, so the
# defaults below already work out of the box. Uncomment to change things.

# --- Provider ----------------------------------------------------------
# AIDE_API__BASE_URL=http://localhost:11434/v1
# AIDE_API__MODEL=gpt-oss:120b-cloud
# AIDE_API__API_KEY=ollama        # env fallback; never commit real keys
# AIDE_API__TEMPERATURE=0.7
# AIDE_API__MAX_TOKENS=4096
# AIDE_API__TIMEOUT=120.0

# --- UI / logging ------------------------------------------------------
# AIDE_UI__THEME=gruvbox-dark
# AIDE_LOG__LEVEL=INFO

# --- Storage (defaults to XDG) -----------------------------------------
# XDG_CONFIG_HOME=~/.config
# XDG_STATE_HOME=~/.local/state
